# Copy to .env in the project root (or export in your shell).
# Prefer keeping this project on the WSL filesystem.

PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Ollama (optional for first npm run dev — situational AI + question build only)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# If Ollama runs on Windows and the app runs in WSL2, 127.0.0.1 inside WSL
# is NOT the Windows host. Use the Windows host IP from WSL, e.g.:
#   OLLAMA_BASE_URL=http://$(grep -m1 nameserver /etc/resolv.conf | awk '{print $2}'):11434
# Or enable mirrored networking / localhost forwarding in .wslconfig.
# If Ollama runs inside WSL, keep http://127.0.0.1:11434.
